#!/usr/bin/with-contenv bash

# POC: instala e roda o Sunshine ao lado do Selkies/Xvfb ja existente na
# imagem base (linuxserver/dolphin), pra comparar lat/input lag do
# Moonlight contra o streaming atual via KasmVNC.
#
# IMPORTANTE: a imagem roda em modo Wayland por padrao
# (PIXELFLUX_WAYLAND=true e o default do proprio Dockerfile da imagem -
# confirmado via `docker inspect`). Em modo Wayland, svc-xorg nem chega a
# subir o Xvfb (o run script dele faz `sleep infinity` de proposito). O
# Sunshine no Linux nao tem suporte robusto a Wayland (so X11/KMS/NvFBC),
# entao este mod SO funciona com PIXELFLUX_WAYLAND=false setado no env do
# pod - isso obriga o Xvfb (svc-xorg) a subir de verdade em :1. Confirmado
# rodando local: com PIXELFLUX_WAYLAND=false o Sunshine loga "Screencasting
# with X11" e captura certo; sem isso, o wait abaixo nunca destrava (o
# timeout avisa nesse caso em vez de travar silenciosamente pra sempre).
#
# Xvfb (svc-xorg) e um X puramente por software, sem bind real de
# KMS/DRM - confirmado lendo o run script dele na imagem. Por isso o
# Selkies ja captura via XSHM (nao NvFBC) e so usa a GPU pra encode
# (NVENC via libavcodec). O Sunshine faz o mesmo: cai automaticamente
# pro capture X11/XSHM quando nao ha KMS real, entao roda sem
# configuracao extra alem de DISPLAY (ja vem como ENV=:1 na imagem).

SUNSHINE_CONFIG_DIR="/config/sunshine"

# O .deb do Sunshine e buildado contra libs de uma distro/versao especifica
# (ex.: libicu76 so existe no Debian trixie, nao no Ubuntu) - baixar o
# pacote errado instala mas fica com dependencias quebradas (confirmado:
# "Depends: libicu76 (>= 76.1-1~) but it is not installable" tentando usar
# o .deb do Debian trixie numa imagem base Ubuntu 26.04). As imagens
# linuxserver.io deste projeto misturam Debian trixie e Ubuntu 26.04 -
# resolve o asset certo lendo /etc/os-release em vez de fixar uma URL.
if [ -z "${SUNSHINE_ASSET_URL}" ]; then
  . /etc/os-release
  case "${ID}" in
    ubuntu) SUNSHINE_ASSET_URL="https://github.com/LizardByte/Sunshine/releases/latest/download/sunshine-ubuntu-${VERSION_ID}-amd64.deb" ;;
    debian) SUNSHINE_ASSET_URL="https://github.com/LizardByte/Sunshine/releases/latest/download/sunshine-debian-${VERSION_CODENAME}-amd64.deb" ;;
    *)
      echo "**** [sunshine-mod] distro base '${ID}' desconhecida, assumindo Debian trixie (pode falhar) ****"
      SUNSHINE_ASSET_URL="https://github.com/LizardByte/Sunshine/releases/latest/download/sunshine-debian-trixie-amd64.deb"
      ;;
  esac
fi

# Espera o Xvfb (svc-xorg) estar de pe antes de tentar capturar o display.
# Com timeout: se PIXELFLUX_WAYLAND=false nao foi setado, o Xvfb nunca sobe
# e isso travaria pra sempre sem explicar o motivo.
WAIT_ELAPSED=0
WAIT_TIMEOUT=60
until [ -e "/tmp/.X11-unix/X${DISPLAY#:}" ]; do
  if [ "${WAIT_ELAPSED}" -ge "${WAIT_TIMEOUT}" ]; then
    echo "**** [sunshine-mod] Xvfb (X${DISPLAY#:}) nao subiu apos ${WAIT_TIMEOUT}s. ****"
    echo "**** [sunshine-mod] Verifique se PIXELFLUX_WAYLAND=false esta setado no env do pod - ****"
    echo "**** [sunshine-mod] sem isso a imagem roda em modo Wayland e o Sunshine nao consegue capturar. ****"
    exec sleep infinity
  fi
  sleep 0.5
  WAIT_ELAPSED=$((WAIT_ELAPSED + 1))
done

# NOTA (POC): o filesystem do container e efemero - so /config e /romm/*
# sao PVC. Isso significa que o Sunshine e reinstalado via apt a cada
# restart/recriacao do pod (nao so na primeira vez). Aceitavel pra POC de
# lat/input lag; se for pra produzir, vale trocar por uma imagem propria
# com o Sunshine ja embutido em vez de instalar em runtime.
if ! command -v sunshine >/dev/null 2>&1; then
  echo "**** [sunshine-mod] instalando Sunshine (via apt, resolve dependencias automaticamente) ****"
  TMP_DEB="$(mktemp /tmp/sunshine-XXXXXX.deb)"
  if ! curl -fL --retry 3 -o "${TMP_DEB}" "${SUNSHINE_ASSET_URL}"; then
    echo "**** [sunshine-mod] falha ao baixar o Sunshine de ${SUNSHINE_ASSET_URL} - sem streaming Moonlight nesta sessao ****"
    exec sleep infinity
  fi
  # svc-udev tambem roda apt-get (pro driver libinput) sem ordem garantida
  # em relacao a este script. DPkg::Lock::Timeout sozinho nao foi
  # suficiente (confirmado: ainda falhava as vezes mesmo com timeout=120,
  # provavelmente por dpkg triggers concorrentes, nao so lock de arquivo).
  # flock serializa de verdade com o mesmo lockfile que svc-udev usa.
  if ! flock /var/lock/sunshine-mod-apt.lock bash -c "
    apt-get -o DPkg::Lock::Timeout=120 update -qq &&
    apt-get -o DPkg::Lock::Timeout=120 install -y --no-install-recommends '${TMP_DEB}'
  "; then
    echo "**** [sunshine-mod] falha ao instalar o pacote do Sunshine - sem streaming Moonlight nesta sessao ****"
    rm -f "${TMP_DEB}"
    exec sleep infinity
  fi
  rm -f "${TMP_DEB}"
fi

mkdir -p "${SUNSHINE_CONFIG_DIR}"
chown -R abc:abc "${SUNSHINE_CONFIG_DIR}"

# Sunshine so aceita UMA porta configuravel ("port", a porta "http") -
# todas as outras (https, web UI, rtsp, video, control, audio, mic) sao
# offsets FIXOS a partir dela (confirmado no codigo fonte: net::map_port
# faz base+offset). SUNSHINE_PORT vem do chart (sunshine.port), default
# 47989 igual ao proprio Sunshine. Precisa ser configurado aqui - os
# containerPort do Deployment sao so documentacao/hostPort binding, quem
# decide a porta de verdade e o sunshine.conf.
if [ -n "${SUNSHINE_PORT}" ] && ! grep -q '^port' "${SUNSHINE_CONFIG_DIR}/sunshine.conf" 2>/dev/null; then
  echo "port = ${SUNSHINE_PORT}" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
fi

# A Web UI do Sunshine bloqueia por CSRF se o Origin do browser nao estiver
# na allowlist (ex.: acessando por IP em vez de localhost) - confirmado:
# "The request was blocked by CSRF protection" ao abrir por IP. Em vez de
# depender de SUNSHINE_CSRF_ALLOWED_ORIGINS setado na mao por emulador
# (esquecivel - ja aconteceu de faltar em 4 de 6), detecta o proprio IP
# automaticamente: com hostNetwork:true o container enxerga a rede do
# host direto, entao "ip route get" pra qualquer destino externo retorna
# o IP real do node como source, sem depender do nome da interface (que
# ja variou entre nodes deste cluster - eth0 vs ens18). SUNSHINE_PORT+1 e
# a porta da Web UI (offset fixo do Sunshine). Ainda permite
# SUNSHINE_CSRF_ALLOWED_ORIGINS como override manual se setado.
if ! grep -q '^csrf_allowed_origins' "${SUNSHINE_CONFIG_DIR}/sunshine.conf" 2>/dev/null; then
  if [ -n "${SUNSHINE_CSRF_ALLOWED_ORIGINS}" ]; then
    echo "csrf_allowed_origins = ${SUNSHINE_CSRF_ALLOWED_ORIGINS}" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
  else
    SELF_IP="$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+')"
    WEB_PORT="$(( ${SUNSHINE_PORT:-47989} + 1 ))"
    if [ -n "${SELF_IP}" ]; then
      echo "csrf_allowed_origins = https://${SELF_IP}:${WEB_PORT}" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
    else
      echo "**** [sunshine-mod] nao consegui detectar o IP do node pra allowlist do CSRF - a Web UI pode bloquear acesso por IP. ****"
    fi
  fi
fi

# Sunshine cria mouse/teclado/gamepad virtuais via uinput. O node so
# aparece se o container foi criado com --device=/dev/uinput (docker) ou
# um hostPath equivalente (k8s) - sem isso o video funciona mas nao da
# pra interagir (confirmado: "Unable to create virtual mouse/keyboard: No
# such file or directory" no log quando o device nao esta presente). O
# node no host normalmente e 0600 root:root, e o Sunshine roda como
# usuario "abc" (nao-root), entao precisa desse chmod pra funcionar.
if [ -e /dev/uinput ]; then
  chmod 666 /dev/uinput
else
  echo "**** [sunshine-mod] /dev/uinput nao encontrado no container - mouse/teclado/gamepad NAO vao funcionar. ****"
  echo "**** [sunshine-mod] Passe --device=/dev/uinput (docker) ou monte /dev/uinput via hostPath (k8s). ****"
fi

# /dev/uhid e necessario pro Sunshine criar qualquer gamepad virtual "de
# verdade" no Linux (DS4/DS5/Switch/Xbox One - todos passam por uhid nesse
# backend, so o uinput puro nao basta). Mesmo chmod que uinput - o node
# normalmente e 0600 root:root no host.
if [ -e /dev/uhid ]; then
  chmod 666 /dev/uhid
else
  echo "**** [sunshine-mod] /dev/uhid nao encontrado no container - gamepad NAO vai funcionar (so mouse/teclado via uinput). ****"
  echo "**** [sunshine-mod] Passe --device=/dev/uhid (docker) ou monte /dev/uhid via hostPath (k8s). ****"
fi

# BUG CONFIRMADO (2026-08-21): com uhid presente e /dev/uhid liberado, o
# auto-select do Sunshine ("gamepad = auto", o default) escolhe DualShock
# 4/5 quando o cliente Moonlight reporta um controle PS4/PS5 real - e
# nesse ponto o log mostra "Gamepad 0 will be DualShock 5 controller" sem
# NENHUM erro, o device uhid e criado normal (confirmado via
# /proc/bus/input/devices e evtest no event node), mas ZERO eventos de
# botao ou analogico chegam no kernel, em qualquer sessao, com dois
# clientes Moonlight diferentes (desktop Linux e Android) testados. A
# causa raiz e a ausencia do driver de kernel hid-playstation neste node
# Talos (`grep -i playstation /proc/modules` vazio) - sem ele, o kernel
# usa hid-generic pro report descriptor DS4/DS5 do Sunshine, que nao
# consegue tra-lo corretamente nesse cenario. Forcar "xone" (Xbox One,
# bem suportado por hid-generic sem quirks especiais) resolve
# completamente - confirmado botao a botao no Dolphin apos essa mudanca.
# "ds4" NAO e uma opcao valida no Linux (so Windows) - setar isso e
# ignorado silenciosamente pelo Sunshine, que cai de volta pro auto/DS5
# quebrado (foi o que aconteceu na primeira tentativa de fix). No Linux
# os valores validos sao: auto, ds5, switch, xone.
if [ -n "${SUNSHINE_GAMEPAD_TYPE}" ] && ! grep -q '^gamepad' "${SUNSHINE_CONFIG_DIR}/sunshine.conf" 2>/dev/null; then
  echo "gamepad = ${SUNSHINE_GAMEPAD_TYPE}" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
elif ! grep -q '^gamepad' "${SUNSHINE_CONFIG_DIR}/sunshine.conf" 2>/dev/null; then
  echo "gamepad = xone" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
fi

# Performance: pula o auto-probe de encoder que o Sunshine faz a cada
# start (testa nvenc/av1_nvenc/software em sequencia, gerando os erros
# "Provided device doesn't support..." vistos no log) - forcar nvenc
# direto, ja confirmado disponivel (RTX 3050 no node), inicia a sessao
# mais rapido.
if ! grep -q '^encoder' "${SUNSHINE_CONFIG_DIR}/sunshine.conf" 2>/dev/null; then
  echo "encoder = nvenc" >> "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
fi

# apps.json (Moonlight app list): o Sunshine le do XDG_CONFIG_HOME (nao do
# SUNSHINE_CONFIG_DIR acima, que so serve o sunshine.conf como argumento
# de linha de comando), com HOME=/config vira /config/.config/sunshine/
# apps.json. Sem isso, o default de fabrica aparece no Moonlight ("Desktop",
# "Low Res Desktop" com xrandr pra uma saida HDMI-1 que nao existe no
# driver dummy, "Steam Big Picture") - substitui por uma unica entrada com
# nome/icone do emulador. Sem "cmd": funciona igual ao "Desktop" default,
# so streama a sessao ja rodando (o emulador ja autostarta via svc-de).
SUNSHINE_XDG_CONFIG_DIR="/config/.config/sunshine"
mkdir -p "${SUNSHINE_XDG_CONFIG_DIR}"
if [ ! -f "${SUNSHINE_XDG_CONFIG_DIR}/apps.json" ]; then
  cat > "${SUNSHINE_XDG_CONFIG_DIR}/apps.json" <<'APPSEOF'
{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      "name": "Dolphin",
      "image-path": "/usr/share/sunshine-mod-assets/icon.png"
    }
  ]
}
APPSEOF
fi
chown -R abc:abc "${SUNSHINE_XDG_CONFIG_DIR}"

export HOME=/config

exec s6-setuidgid abc \
  /usr/bin/sunshine "${SUNSHINE_CONFIG_DIR}/sunshine.conf"
